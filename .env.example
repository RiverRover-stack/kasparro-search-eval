# Copy this file to .env and fill in the blanks. .env is ignored by Git. Never commit real values.
# Variables already set in your shell override the ones in .env. Run commands from the project folder,
# because the two path settings below are relative.

# Bearer token for the analyst role (import, analyse, create/edit/submit reports). Choose any long secret.
KASPARRO_ANALYST_TOKEN=
# Bearer token for the reviewer role (approve or reject). Must differ from the analyst token.
KASPARRO_REVIEWER_TOKEN=

# Groq API key. Only needed for execution_mode "hosted_groq". Leave blank for stub, replay or local runs.
GROQ_API_KEY=
# Groq model. The evaluated model is the 120b. The code default is the unevaluated 20b, so set this.
KASPARRO_GROQ_MODEL=openai/gpt-oss-120b

# Database location. Default is backend/kasparro.db inside this folder.
KASPARRO_DATABASE_URL=sqlite:///backend/kasparro.db
# Folder that holds the input pack (data/, provenance/, PACK_MANIFEST.json). Default is this folder.
KASPARRO_INPUT_PACK=.
# Longest answer text, in characters, that is sent to a model.
KASPARRO_MAX_INPUT_CHARS=20000
# Context size, in tokens, asked of a local Ollama model.
KASPARRO_OLLAMA_CONTEXT_TOKENS=16384
